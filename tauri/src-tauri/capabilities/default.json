{
  "$schema": "https://schema.tauri.app/capability/2",
  "identifier": "default",
  "description": "Glint 窗口能力（面板 + 桌面组件）：核心 API + 事件监听 + 通知 + 剪贴板写入",
  "windows": ["panel", "widget"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "notification:default",
    "clipboard-manager:allow-write-text"
  ]
}
